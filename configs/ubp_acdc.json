{
  "architecture": "ubp",
  "dataset": "acdc",
  "data_root": "data/MEDDATA",
  "seed": 1234,
  "image_size": 224,
  "batch_size": 24,
  "epochs": 300,
  "learning_rate": 0.01,
  "weight_decay": 0.0002,
  "ce_weight": 0.5,
  "dice_weight": 0.5,
  "workers": 2,
  "threads": 4,
  "validation_interval": 5,
  "inference_batch_size": 4,
  "cache_in_ram": true,
  "amp": false,
  "gpu_memory_fraction": 0.65,
  "partition_protocol": "patient_level_90_10_holdout_from_meddata_training_pool",
  "image_interpolation": "cubic",
  "augmentation_mode": "flip_rotate",
  "resize_after_augmentation": true,
  "schedule": "polynomial_per_step_power_0.9",
  "optimizer": "AdamW",
  "pretraining": "scratch",
  "lambda_aux": 0.3,
  "refinement_enabled": true,
  "selective_gating": true
}
