{
  "architecture": "ubp",
  "dataset": "synapse",
  "data_root": "data/MEDDATA/Synapse",
  "data_dirs": {
    "train_slices": "train_npz",
    "test_volumes": "test_vol_h5"
  },
  "slice_extensions": [".npz"],
  "volume_extensions": [".h5"],
  "image_range": [0.0, 1.0],
  "image_interpolation": "cubic",
  "augmentation_mode": "flip_rotate",
  "seed": 1234,
  "image_size": 224,
  "batch_size": 24,
  "epochs": 300,
  "learning_rate": 0.001,
  "weight_decay": 0.0002,
  "ce_weight": 0.4,
  "dice_weight": 0.6,
  "lambda_aux": 0.3,
  "workers": 2,
  "threads": 4,
  "validation_interval": 5,
  "inference_batch_size": 4,
  "cache_in_ram": true,
  "amp": false,
  "gpu_memory_fraction": 0.65,
  "partition_protocol": "internal_training_pool_validation_15_3_12",
  "normalization": "preserve_preprocessed_0_to1",
  "gradient_clip_norm": null,
  "refinement_enabled": true,
  "selective_gating": true
}
